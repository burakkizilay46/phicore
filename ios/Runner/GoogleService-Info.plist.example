<?xml version="1.0" encoding="UTF-8"?>
<!--
  PLACEHOLDER — Firebase Console > Project settings > iOS uygulamanız için
  "GoogleService-Info.plist" dosyasını indirip Xcode ile Runner target'a ekleyin
  (sadece dosyayı klasöre kopyalamak yetmez; Xcode'da target'a dahil edilmeli).
  flutterfire configure çalıştırırsanız bu dosya otomatik oluşturulur.
  Gerçek dosya .gitignore ile yok sayılır.

  Ayrıca: bu plist içindeki REVERSED_CLIENT_ID değerini
  ios/Runner/Info.plist > CFBundleURLSchemes (TODO_REVERSED_CLIENT_ID) yerine yazın.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>TODO_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>TODO_MESSAGING_SENDER_ID</string>
	<key>BUNDLE_ID</key>
	<string>com.example.phicore</string>
	<key>PROJECT_ID</key>
	<string>TODO_PROJECT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>TODO_PROJECT_ID.appspot.com</string>
	<key>GOOGLE_APP_ID</key>
	<string>TODO_IOS_APP_ID</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>TODO_REVERSED_CLIENT_ID</string>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
</dict>
</plist>
